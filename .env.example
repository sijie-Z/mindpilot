# MindPilot Docker Compose Environment
# Copy this file to .env and fill in your values

# Required: Security
SECRET_KEY=generate-with-python-c-import-secrets-print-secrets-token-urlsafe-64

# Required: Database
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_PASSWORD=change-me-app-password

# Required: AI Service
ZHIPU_API_KEY=your-zhipu-api-key

# Optional: Redis (set if you want password protection)
REDIS_PASSWORD=

# Optional: MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-password
